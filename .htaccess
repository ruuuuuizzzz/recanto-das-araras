Options -Indexes
DirectoryIndex index.php
RewriteEngine On

RewriteRule ^(?:app|bootstrap|config|database|routes|storage|bin|tests|vendor|docs)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

# Public assets are served directly; existing page URLs use the route map.
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^style/(.*)$ public/assets/css/$1 [L]
RewriteRule ^js/(.*)$ public/assets/js/$1 [L]
RewriteRule ^img/(.*)$ public/assets/images/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L]
<FilesMatch "^(config_email\.php|composer\.(json|lock)|README\.md|.*\.(sql|log|bak|env))$">
    Require all denied
</FilesMatch>
